            "name": "STLink Debug",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "device": "STM32G473MC",
            "executable": "${workspaceFolder}/build/STM32G473_ADC.elf",
            "interface": "swd",
            "preLaunchTask": "make flash", 
            "svdFile": "STM32G473.svd",
        }
